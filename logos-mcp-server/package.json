{
  "name": "logos-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for Logos Bible Software integration",
  "license": "MIT",
  "author": "Rob Pecoraro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevewesthoek/LogosBibleSoftwareMCP.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "logos",
    "bible",
    "bible-study",
    "claude",
    "codex",
    "chatgpt",
    "knowledge-provider"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "logos-mcp": "dist/index.js",
    "logos-mcp-diagnose": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagnose": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
